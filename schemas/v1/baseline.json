          "first_seen_at": {
            "type": "string"
          },
          "freshness": {
            "type": "string"
          },
          "health": {
            "type": "string"
          },
          "health_detail": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "image": {
            "type": "string"
          },
          "image_digest": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "labels": {},
          "last_seen_at": {
            "type": "string"
          },
          "latest_digest": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_external_id": {
            "type": "string"
          },
          "ports": {},
          "state": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "external_id",
          "name",
          "kind",
          "image",
          "state",
          "health",
          "freshness",
          "ports",
          "labels",
          "first_seen_at",
          "last_seen_at",
          "updated_at"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "properties": {
      "generated_at": {
        "type": "string"
      },
      "hosts": {
        "items": {
          "$ref": "#/$defs/host"
        },
        "type": "array"
      },
      "pagination": {
        "$ref": "#/$defs/pagination"
      }
    },
